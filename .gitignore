celerybeat-schedule
celerybeat.pid
*.cpickle

# ─── Redis / Cache ─────────────────────────────────────────────────────────────
dump.rdb

# ─── Docker ────────────────────────────────────────────────────────────────────
.dockerignore
docker-compose.override.yml

