# ─── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
*.so

# ─── Virtual Environments ───────────────────────────────────────────────────────
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
Pipfile.lock

# ─── Django ────────────────────────────────────────────────────────────────────
db.sqlite3
db.sqlite3-journal
*.log
local_settings.py

# Collected static files (generated by collectstatic — don't commit)
staticfiles/

# Media uploads (user-generated content — don't commit)
media/

# Django secret / session keys
*.key

# ─── Environment Variables & Secrets ───────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
secrets.json

# ─── Migrations ────────────────────────────────────────────────────────────────
# Keep migration files but ignore their pycache
**/migrations/__pycache__/

# ─── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
test-results/
junit.xml

# ─── Build & Distribution ──────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST
wheels/
pip-wheel-metadata/
share/python-wheels/
.eggs/

# ─── Type Checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ─── Linting & Formatting ──────────────────────────────────────────────────────
.ruff_cache/

# ─── IDEs & Editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
*.sublime-project
*.sublime-workspace
.spyderproject/
.spyproject/
.ropeproject/

